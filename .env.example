# Application Environment
APP_NAME=Kestrel Support & Resolution Suite
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL for Docker/Production, SQLite supported for zero-setup local dev)
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://kestrel:change_me_db_password@localhost:5432/kestrel_support
DATABASE_URL=sqlite:///./kestrel_support.db

# Authentication & Security (Replace with a strong 32+ char random secret in production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Business Rules
AUTO_REFUND_LIMIT_INR=5000

# AI Agent Configuration
# Supported providers: local_deterministic (default, no API key needed), openai_compatible
LLM_PROVIDER=local_deterministic
LLM_API_KEY=your-optional-llm-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api
