# Application Environment
APP_NAME=Kestrel Support & Resolution Suite
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL primary; optional SQLite fallback for zero-setup local dev)
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/support_desk
# DATABASE_URL=sqlite:///./kestrel_support.db

# Authentication & Security (Replace with a strong 32+ char random secret in production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Business Rules
AUTO_REFUND_LIMIT_INR=5000

# AI Agent Configuration
# Supported providers: local_deterministic (default, no API key needed), gemini, openai_compatible
LLM_PROVIDER=local_deterministic
LLM_API_KEY=your-optional-gemini-or-openai-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api

# Docker Hub Repository Mapping
DOCKERHUB_REPO=souravoz/assignment3
